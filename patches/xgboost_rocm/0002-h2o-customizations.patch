+  int right_child;
+  double split_value;
+  double leaf_value;
+  bool is_leaf;
+
+  XgbTreeNode() : number(0), feature(""), gain(0), cover(0),
+    left_child(-1), right_child(-1), split_value(0), leaf_value(0), is_leaf(false) { }
+};
+
